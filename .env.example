# Copy to `.env` and fill in. `.env` is gitignored.
#   cp .env.example .env
#
# Everything here is optional. With no key at all the app starts in demo mode
# and replays recorded answers for the two bundled datasets — it never refuses
# to run.

# ── Provider selection ────────────────────────────────────────
# "groq" (fast, free tier) or "bedrock" (AWS).
LLM_PROVIDER=groq

# ── Groq ──────────────────────────────────────────────────────
# Free key, no card required: https://console.groq.com/keys
# Groq retires model ids periodically; if a call 404s, pick a current one from
# https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── AWS Bedrock ───────────────────────────────────────────────
# Credentials come from the standard AWS chain (env vars, ~/.aws/credentials,
# or an instance role) — do not put secrets here if you can avoid it.
# The model must be enabled for your account in the Bedrock console.
AWS_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Agent behaviour ───────────────────────────────────────────
LLM_TEMPERATURE=0.0          # deterministic code generation
LLM_MAX_TOKENS=2048
MAX_REPAIR_ATTEMPTS=2        # extra tries after a failure; caps token spend at 3x
MAX_API_RETRIES=3
RETRY_BASE_DELAY=2.0
HISTORY_TURNS=10             # conversation turns kept in the prompt

# ── Sandbox limits ────────────────────────────────────────────
SANDBOX_TIMEOUT=30           # seconds before the worker is killed
SANDBOX_MEMORY_MB=2048       # enforced on Linux/macOS only (see README)
SANDBOX_STARTUP_TIMEOUT=60
SANDBOX_MAX_FIGURE_BYTES=8388608
SANDBOX_MAX_OUTPUT_CHARS=20000

# ── Upload limits ─────────────────────────────────────────────
MAX_UPLOAD_MB=100
MAX_ROWS=1000000
PREVIEW_ROWS=5

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
